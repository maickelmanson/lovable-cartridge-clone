# ---------------------------------------------------------------------------
# Exemplo de variáveis de ambiente. Copie para .env e preencha com os valores
# do seu projeto Supabase:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Cliente (expostas no navegador via import.meta.env) -------------------

# ID (ref) do projeto Supabase. Ex.: ejwvxdqkxrcywehtesyo
VITE_SUPABASE_PROJECT_ID="seu-project-ref"

# URL da API do projeto Supabase
VITE_SUPABASE_URL="https://seu-project-ref.supabase.co"

# Chave publicável (anon). Pode ficar no bundle do navegador.
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# --- Servidor (nunca são enviadas ao navegador) ----------------------------

# Mesmos valores acima, lidos pelo runtime do servidor (process.env)
SUPABASE_PROJECT_ID="seu-project-ref"
SUPABASE_URL="https://seu-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# Chave de serviço: ignora RLS. Usada pelo login próprio, pelo proxy de dados
# (/api/db/*), pelos backups e pelos scripts. NUNCA versionar o valor real.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"

# Segredo usado para assinar os tokens JWT do login próprio (mín. 32 chars)
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"

# String de conexão Postgres do projeto. Usada por `npm run seed-sql`.
SUPABASE_DB_URL="postgresql://postgres:SENHA@db.seu-project-ref.supabase.co:5432/postgres"

# Senha da conta técnica que abre a sessão de dados do sistema
APP_SESSION_PASSWORD="uma-senha-forte-qualquer"

# Chave do gateway de IA (recurso de chat/assistente). Opcional.
LOVABLE_API_KEY="sua-chave-do-gateway-de-ia"
